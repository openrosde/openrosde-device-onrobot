<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- OnRobot Quick Changer, robot side (QC-R v3), mounted on 'parent' at 'origin'. -->
<!-- 'prefix' starts the name of every link, joint, and material, so the default 'qc_' gives 'qc_robot_mount', 'qc_body', and 'qc_tool_mount'. -->
<!-- The body is drawn as a cylinder of the size of the quick changer, 71 mm across and 13.6 mm thick, centered on 'qc_body' as the meshes of the quick changer are. -->
<!-- 'visual_mesh' and 'collision_mesh' replace that cylinder with meshes, given as URIs such as 'package://<package>/meshes/onrobot_quick_changer_qc-r_v3.stl'. -->
<!-- The tool side, where a gripper mounts, sits on 'qc_tool_mount', 13.6 mm above 'qc_robot_mount'. -->
<xacro:macro name="onrobot_qc_r_v3" params="parent *origin prefix:=qc_ visual_mesh:='' collision_mesh:=''">

  <link name="${prefix}robot_mount"/>

  <joint name="${prefix}robot_mount_joint" type="fixed">
    <xacro:insert_block name="origin" />
    <parent link="${parent}"/>
    <child link="${prefix}robot_mount"/>
  </joint>

  <link name="${prefix}body">
    <visual>
      <geometry>
        <xacro:if value="${visual_mesh != ''}">
          <mesh filename="${visual_mesh}"/>
        </xacro:if>
        <xacro:unless value="${visual_mesh != ''}">
          <cylinder radius="0.0355" length="0.0136"/>
        </xacro:unless>
      </geometry>
      <material name="${prefix}blue">
        <color rgba="0 0.35 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <xacro:if value="${collision_mesh != ''}">
          <mesh filename="${collision_mesh}"/>
        </xacro:if>
        <xacro:unless value="${collision_mesh != ''}">
          <cylinder radius="0.0355" length="0.0136"/>
        </xacro:unless>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.13"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="4.296185833333333e-05" iyy="4.296185833333333e-05" izz="8.191625e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="${prefix}robot_joint" type="fixed">
    <parent link="${prefix}robot_mount"/>
    <child link="${prefix}body"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="${prefix}tool_mount"/>

  <joint name="${prefix}tool_joint" type="fixed">
    <parent link="${prefix}body"/>
    <child link="${prefix}tool_mount"/>
    <origin xyz="0 0 0.0136"/>
  </joint>

  <!-- Gazebo -->
  <gazebo reference="${prefix}body">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</xacro:macro>

</robot>
